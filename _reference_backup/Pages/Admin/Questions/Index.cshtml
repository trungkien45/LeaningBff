@page
@using LearningBff.Entities
@model LearningBff.Pages.Admin.Questions.IndexModel
@{
    ViewData["Title"] = "Quản lý Câu hỏi";
}

<div class="admin-questions-page">
    <div class="page-header">
        <div class="page-title">
            <a href="/Admin/Subjects" class="back-link"><i class="fas fa-arrow-left"></i></a>
            <i class="fas fa-question-circle"></i>
            <h1>Câu hỏi @(Model.FilterSubject != null ? $"— {Model.FilterSubject.Name}" : "")</h1>
        </div>
        <div class="header-actions">
            @*
            <a class="btn-secondary" href="/templates/question-import-template.xlsx" download>
                <i class="fas fa-file-excel"></i> Tải template Excel
            </a>
            *@
            <button class="btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus"></i> Thêm câu hỏi
            </button>
        </div>
    </div>

    <!-- Filters -->
    <form method="get" class="filter-bar">
        <input type="hidden" name="page" value="1" />
        <select name="subjectId" onchange="this.form.submit()" class="filter-select">
            <option value="">-- Tất cả môn học --</option>
            @foreach (var s in Model.Subjects)
            {
                <option value="@s.Id" selected="@(Model.SubjectId == s.Id)">@s.Name</option>
            }
        </select>
        <select name="type" onchange="this.form.submit()" class="filter-select">
            <option value="">-- Tất cả loại --</option>
            <option value="Single" selected="@(Model.TypeFilter == "Single")">Một đáp án</option>
            <option value="Multi"  selected="@(Model.TypeFilter == "Multi")">Nhiều đáp án</option>
        </select>
    </form>

    <form method="post" asp-page-handler="Import" enctype="multipart/form-data" class="import-bar">
        <select name="SubjectId" required class="filter-select">
            <option value="">-- Chọn môn học để import --</option>
            @foreach (var s in Model.Subjects)
            {
                <option value="@s.Id" selected="@(Model.SubjectId == s.Id)">@s.Name</option>
            }
        </select>
        <input type="file" name="File" accept=".xlsx" required class="file-input" />
        <a class="btn-secondary" href="/templates/question-import-template.xlsx" download>
            <i class="fas fa-file-excel"></i> Tải template
        </a>
        <button type="submit" class="btn-success">
            <i class="fas fa-upload"></i> Import Excel
        </button>
    </form>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    { <div class="alert alert-success"><i class="fas fa-check-circle"></i> @Model.SuccessMessage</div> }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    { <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage</div> }

    <div class="questions-list">
        @foreach (var q in Model.Questions)
        {
            <div class="question-card">
                <div class="question-meta">
                    <span class="badge badge-subject">@q.SubjectName</span>
                    <span class="badge badge-type @(q.Type == QuestionType.Single ? "single" : "multi")">
                        @(q.Type == QuestionType.Single ? "Một đáp án" : "Nhiều đáp án")
                    </span>
                    <span class="badge badge-difficulty diff-@q.Difficulty.ToString().ToLower()">
                        @(q.Difficulty == QuestionDifficulty.Easy ? "Dễ" : q.Difficulty == QuestionDifficulty.Medium ? "Trung bình" : "Khó")
                    </span>
                    <span class="badge badge-score"><i class="fas fa-star"></i> @q.DefaultScore điểm</span>
                </div>
                <h3 class="question-title">@q.Title</h3>
                <div class="answers-preview">
                    @foreach (var a in q.Answers)
                    {
                        <div class="answer-item @(a.IsCorrect ? "correct" : "")">
                            <i class="fas @(a.IsCorrect ? "fa-check-circle" : "fa-circle")"></i>
                            @a.Text
                        </div>
                    }
                </div>
                <div class="question-actions">
                    <button class="btn-sm btn-warning" onclick="editQuestion(@q.Id)">
                        <i class="fas fa-edit"></i> Sửa
                    </button>
                    <form method="post" asp-page-handler="Delete" style="display:inline"
                          onsubmit="return confirm('Xóa câu hỏi này?')">
                        <input type="hidden" name="id" value="@q.Id" />
                        <button type="submit" class="btn-sm btn-danger"><i class="fas fa-trash"></i> Xóa</button>
                    </form>
                </div>
            </div>
        }
        @if (!Model.Questions.Any())
        {
            <div class="empty-state">
                <i class="fas fa-question-circle"></i>
                <p>Chưa có câu hỏi nào.</p>
            </div>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Phân trang câu hỏi">
            <ul class="pagination align-items-center mb-0">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="./Index" asp-route-subjectId="@Model.SubjectId" asp-route-type="@Model.TypeFilter" asp-route-page="@(Model.CurrentPage - 1)">Trước</a>
                    </li>
                }
                <li class="page-item disabled"><span class="page-link">Trang @Model.CurrentPage / @Model.TotalPages · @Model.TotalCount câu hỏi</span></li>
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="./Index" asp-route-subjectId="@Model.SubjectId" asp-route-type="@Model.TypeFilter" asp-route-page="@(Model.CurrentPage + 1)">Sau</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<!-- Create/Edit Modal -->
<div id="questionModal" class="modal-overlay" style="display:none">
    <div class="modal modal-large">
        <div class="modal-header">
            <h2 id="modalTitle"><i class="fas fa-plus-circle"></i> Thêm câu hỏi</h2>
            <button onclick="closeModal('questionModal')" class="modal-close">&times;</button>
        </div>
        <form method="post" id="questionForm">
            <div class="modal-body">
                <input type="hidden" name="Id" id="qId" value="0" />

                <div class="form-row">
                    <div class="form-group flex-2">
                        <label>Môn học <span class="required">*</span></label>
                        <select name="SubjectId" id="qSubjectId" required>
                            @foreach (var s in Model.Subjects)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Loại câu hỏi</label>
                        <select name="Type" id="qType">
                            <option value="Single">Một đáp án đúng</option>
                            <option value="Multi">Nhiều đáp án đúng</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Độ khó</label>
                        <select name="Difficulty" id="qDifficulty">
                            <option value="1">Dễ</option>
                            <option value="2" selected>Trung bình</option>
                            <option value="3">Khó</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Điểm mặc định</label>
                        <input type="number" name="DefaultScore" id="qScore" value="1" min="0.1" step="0.1" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Nội dung câu hỏi <span class="required">*</span></label>
                    <textarea name="Title" id="qTitle" required rows="3" placeholder="Nhập câu hỏi..."></textarea>
                </div>

                <div class="form-group">
                    <label>Giải thích chung (không bắt buộc)</label>
                    <textarea name="GeneralExplanation" id="qExplanation" rows="2"></textarea>
                </div>

                <div class="answers-section">
                    <div class="answers-header">
                        <label>Các đáp án <span class="required">*</span></label>
                        <button type="button" class="btn-sm btn-info" onclick="addAnswer()">
                            <i class="fas fa-plus"></i> Thêm đáp án
                        </button>
                    </div>
                    <div id="answersContainer"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeModal('questionModal')" class="btn-secondary">Hủy</button>
                <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Lưu câu hỏi</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
const questionsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Questions));
let answerCount = 0;

function openCreateModal() {
    document.getElementById('modalTitle').innerHTML = '<i class="fas fa-plus-circle"></i> Thêm câu hỏi';
    document.getElementById('questionForm').setAttribute('asp-page-handler','Create');
    document.getElementById('questionForm').action = '?handler=Create';
    document.getElementById('qId').value = '0';
    document.getElementById('qTitle').value = '';
    document.getElementById('qExplanation').value = '';
    document.getElementById('qScore').value = '1';
    document.getElementById('qType').value = 'Single';
    document.getElementById('qDifficulty').value = '2';
    answerCount = 0;
    document.getElementById('answersContainer').innerHTML = '';
    addAnswer(); addAnswer(); addAnswer(); addAnswer();
    document.getElementById('questionModal').style.display = 'flex';
}

function editQuestion(id) {
    const q = questionsData.find(x => (x.Id === id || x.id === id));
    if (!q) return;
    document.getElementById('modalTitle').innerHTML = '<i class="fas fa-edit"></i> Sửa câu hỏi';
    document.getElementById('questionForm').action = '?handler=Update';
    document.getElementById('qId').value = q.Id ?? q.id;
    document.getElementById('qTitle').value = q.Title ?? q.title;
    document.getElementById('qExplanation').value = q.GeneralExplanation ?? q.generalExplanation ?? '';
    document.getElementById('qScore').value = q.DefaultScore ?? q.defaultScore ?? 1;
    document.getElementById('qType').value = q.Type ?? q.type;
    document.getElementById('qDifficulty').value = q.Difficulty ?? q.difficulty;
    document.getElementById('qSubjectId').value = q.SubjectId ?? q.subjectId;
    answerCount = 0;
    document.getElementById('answersContainer').innerHTML = '';
    const answers = q.Answers ?? q.answers ?? [];
    answers.forEach(a => addAnswer(a.Id ?? a.id ?? 0, a.Text ?? a.text ?? '', a.IsCorrect ?? a.isCorrect ?? false, a.Explanation ?? a.explanation ?? ''));
    document.getElementById('questionModal').style.display = 'flex';
}

function addAnswer(id = 0, text = '', isCorrect = false, explanation = '') {
    const i = answerCount++;
    const div = document.createElement('div');
    div.className = 'answer-editor';
    div.innerHTML = `
        <input type="hidden" name="Answers[${i}].Id" value="${id}" />
        <div class="answer-editor-row">
            <label class="answer-correct-label">
                <input type="checkbox" name="Answers[${i}].IsCorrect" value="true" ${isCorrect ? 'checked' : ''} />
                Đúng
            </label>
            <input type="text" name="Answers[${i}].Text" value="${text.replace(/"/g,'&quot;')}" placeholder="Nội dung đáp án..." required class="answer-text-input" />
            <input type="hidden" name="Answers[${i}].Order" value="${i}" />
            <button type="button" onclick="this.closest('.answer-editor').remove()" class="btn-icon btn-danger"><i class="fas fa-times"></i></button>
        </div>
        <input type="text" name="Answers[${i}].Explanation" value="${(explanation||'').replace(/"/g,'&quot;')}" placeholder="Giải thích (nếu có)..." class="answer-explanation-input" />
    `;
    document.getElementById('answersContainer').appendChild(div);
}

function closeModal(id) {
    document.getElementById(id).style.display = 'none';
}
// Static backdrop: Bấm ra ngoài không tắt modal (chỉ đóng khi bấm nút close, cancel, ok)
// document.querySelectorAll('.modal-overlay').forEach(o => {
//     o.addEventListener('click', e => { if (e.target === o) o.style.display = 'none'; });
// });

document.getElementById('questionForm').addEventListener('submit', function(e) {
    const type = document.getElementById('qType').value;
    if (type === 'Single') {
        const correctAnswers = document.querySelectorAll('#answersContainer input[type="checkbox"]:checked');
        if (correctAnswers.length !== 1) {
            e.preventDefault();
            alert('Câu hỏi loại "Một đáp án đúng" phải có chính xác 1 đáp án đúng!');
        }
    }
});
</script>
}
