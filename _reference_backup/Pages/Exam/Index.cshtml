@page
@using LearningBff.Entities
@model LearningBff.Pages.Exam.IndexModel
@{
    ViewData["Title"] = "Thi trắc nghiệm";
}

<div class="exam-list-page">
    <div class="exam-list-hero">
        <h1><i class="fas fa-graduation-cap"></i> Kỳ thi trực tuyến</h1>
        <p>Chọn đề thi và bắt đầu ngay. Kết quả được chấm điểm tự động.</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="margin: 1.5rem 0; padding: 1rem 1.25rem; border-radius: 8px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #ef4444; font-weight: 500;">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    }

    @if (Model.MyResultCount > 0)
    {
        <div class="my-history-section">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                <h2 class="mb-0"><i class="fas fa-history"></i> Lịch sử thi</h2>
                <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
                    <input type="hidden" name="resultPage" value="1" />
                    <input type="hidden" name="examSubjectId" value="@Model.SelectedExamSubjectId" />
                    <input type="hidden" name="examPage" value="@Model.ExamPage" />
                    <label for="resultSubjectFilter" class="form-label mb-0 text-nowrap">Môn học</label>
                    <select id="resultSubjectFilter" name="resultSubjectId" class="form-select">
                        <option value="">Tất cả môn</option>
                        @foreach (var subject in Model.ResultSubjects)
                        {
                            <option value="@subject.Id" selected="@(Model.SelectedSubjectId == subject.Id)">@subject.Name</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-outline-primary">Lọc</button>
                </form>
            </div>
            @if (Model.FilteredResults.Any())
            {
                <div class="history-cards">
                    @foreach (var r in Model.FilteredResults)
                    {
                        <a href="/Exam/Result/@r.Id" class="history-card @(r.IsPassed ? "passed" : "failed")">
                            <div class="history-icon">
                                <i class="fas @(r.IsPassed ? "fa-trophy" : "fa-times-circle")"></i>
                            </div>
                            <div class="history-info">
                                <strong>@r.ExamTitle</strong>
                                <span>@r.SubjectName</span>
                                <span>@r.Score / @r.MaxScore điểm · Lần @r.AttemptNumber</span>
                                <span class="history-date">@r.SubmitTime?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div class="history-badge @(r.IsPassed ? "pass" : "fail")">
                                @(r.IsPassed ? "Đạt" : "Chưa đạt")
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">Môn học này chưa có kết quả.</p>
            }
            @if (Model.ResultPageCount > 1)
            {
                <nav class="mt-3" aria-label="Phân trang kết quả thi">
                    <ul class="pagination align-items-center mb-0">
                        @if (Model.ResultPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Index"
                                   asp-route-resultSubjectId="@Model.SelectedSubjectId"
                                   asp-route-resultPage="@(Model.ResultPage - 1)"
                                   asp-route-examSubjectId="@Model.SelectedExamSubjectId"
                                   asp-route-examPage="@Model.ExamPage">Trước</a>
                            </li>
                        }
                        <li class="page-item disabled"><span class="page-link">Trang @Model.ResultPage / @Model.ResultPageCount · @Model.FilteredResultCount kết quả</span></li>
                        @if (Model.ResultPage < Model.ResultPageCount)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Index"
                                   asp-route-resultSubjectId="@Model.SelectedSubjectId"
                                   asp-route-resultPage="@(Model.ResultPage + 1)"
                                   asp-route-examSubjectId="@Model.SelectedExamSubjectId"
                                   asp-route-examPage="@Model.ExamPage">Sau</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    }

    <div class="exams-section">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <h2 class="mb-0"><i class="fas fa-file-alt"></i> Đề thi đang mở</h2>
            <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
                <input type="hidden" name="resultSubjectId" value="@Model.SelectedSubjectId" />
                <input type="hidden" name="resultPage" value="@Model.ResultPage" />
                <input type="hidden" name="examPage" value="1" />
                <label for="examSubjectFilter" class="form-label mb-0 text-nowrap">Môn học</label>
                <select id="examSubjectFilter" name="examSubjectId" class="form-select" disabled="@(!Model.ExamSubjects.Any())">
                    @if (Model.ExamSubjects.Any())
                    {
                        <option value="">Tất cả môn đã đăng ký</option>
                        @foreach (var subject in Model.ExamSubjects)
                        {
                            <option value="@subject.Id" selected="@(Model.SelectedExamSubjectId == subject.Id)">@subject.Name</option>
                        }
                    }
                    else
                    {
                        <option value="">Chưa đăng ký môn nào</option>
                    }
                </select>
                @if (Model.ExamSubjects.Any())
                {
                    <button type="submit" class="btn btn-outline-primary">Lọc</button>
                }
            </form>
        </div>

        @if (!Model.Exams.Any())
        {
            <div class="empty-exams">
                <i class="fas fa-inbox"></i>
                <p>Hiện chưa có đề thi nào được phát hành.</p>
            </div>
        }
        else if (!Model.FilteredExams.Any())
        {
            <div class="empty-exams">
                <i class="fas fa-inbox"></i>
                <p>Môn học này hiện chưa có đề thi đang mở.</p>
            </div>
        }
        else
        {
            <div class="exam-cards-grid">
                @foreach (var exam in Model.FilteredExams)
            {
                var myAttempts = Model.AttemptCounts.GetValueOrDefault(exam.Id);
                var canTake = !exam.MaxAttempts.HasValue || myAttempts < exam.MaxAttempts.Value;
                <div class="exam-card">
                    <div class="exam-card-header">
                        <span class="exam-subject-badge">@exam.SubjectName</span>
                        @if (exam.EndTime.HasValue)
                        {
                            <span class="exam-deadline" title="Hết hạn"><i class="fas fa-clock"></i> @exam.EndTime.Value.ToLocalTime().ToString("dd/MM HH:mm")</span>
                        }
                    </div>
                    <h3 class="exam-card-title">@exam.Title</h3>
                    @if (!string.IsNullOrEmpty(exam.Description))
                    {
                        <p class="exam-card-desc">@exam.Description</p>
                    }
                    <div class="exam-card-stats">
                        <div class="stat">
                            <i class="fas fa-question-circle"></i>
                            <span>@exam.QuestionCount câu</span>
                        </div>
                        <div class="stat">
                            <i class="fas fa-stopwatch"></i>
                            <span>@exam.DurationInMinutes phút</span>
                        </div>
                        <div class="stat">
                            <i class="fas fa-star"></i>
                            <span>Qua môn ≥ @exam.PassScore/@exam.MaxScore</span>
                        </div>
                    </div>
                    @if (myAttempts > 0)
                    {
                        <div class="attempt-info">
                            <i class="fas fa-history"></i> Đã thi @myAttempts lần
                            @if (exam.MaxAttempts.HasValue)
                            {
                                <span>/ @exam.MaxAttempts</span>
                            }
                        </div>
                    }
                    <div class="exam-card-footer">
                        @if (canTake)
                        {
                            <form method="post" asp-page-handler="Start">
                                <input type="hidden" name="examId" value="@exam.Id" />
                                <button type="submit" class="btn-start-exam">
                                    <i class="fas fa-play"></i>
                                    @(myAttempts > 0 ? "Thi lại" : "Bắt đầu thi")
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="btn-exhausted"><i class="fas fa-lock"></i> Đã hết lượt thi</span>
                        }
                    </div>
                </div>
            }
            </div>
            @if (Model.ExamPageCount > 1)
            {
                <nav class="mt-3" aria-label="Phân trang đề thi">
                    <ul class="pagination align-items-center mb-0">
                        @if (Model.ExamPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Index"
                                   asp-route-resultSubjectId="@Model.SelectedSubjectId"
                                   asp-route-resultPage="@Model.ResultPage"
                                   asp-route-examSubjectId="@Model.SelectedExamSubjectId"
                                   asp-route-examPage="@(Model.ExamPage - 1)">Trước</a>
                            </li>
                        }
                        <li class="page-item disabled"><span class="page-link">Trang @Model.ExamPage / @Model.ExamPageCount · @Model.FilteredExamCount đề thi</span></li>
                        @if (Model.ExamPage < Model.ExamPageCount)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Index"
                                   asp-route-resultSubjectId="@Model.SelectedSubjectId"
                                   asp-route-resultPage="@Model.ResultPage"
                                   asp-route-examSubjectId="@Model.SelectedExamSubjectId"
                                   asp-route-examPage="@(Model.ExamPage + 1)">Sau</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
</div>
