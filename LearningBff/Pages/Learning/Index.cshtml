@page
@model LearningBff.Pages.Learning.IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Không gian Học trực tuyến";
}

<style>
    :root {
        --learn-primary: #4f46e5;
        --learn-primary-rgb: 79, 70, 229;
        --learn-secondary: #06b6d4;
        --learn-bg: #f8fafc;
        --learn-card-bg: #ffffff;
        --learn-border: #e2e8f0;
        --learn-text-main: #0f172a;
        --learn-text-muted: #64748b;
        --learn-success: #10b981;
    }

    .learning-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1.5rem 1rem 3rem 1rem;
    }

    /* Hero Banner */
    .learn-hero {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);
        border-radius: 1.25rem;
        padding: 2.5rem 2rem;
        color: #ffffff;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(49, 46, 129, 0.25);
    }
    .learn-hero::after {
        content: '';
        position: absolute;
        top: -30%;
        right: -10%;
        width: 350px;
        height: 350px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.35) 0%, rgba(99, 102, 241, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .learn-hero-title {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        margin-bottom: 0.5rem;
    }
    .learn-hero-desc {
        color: #c7d2fe;
        font-size: 1.05rem;
        max-width: 650px;
        margin-bottom: 1.5rem;
    }

    /* Stats Badge */
    .learn-stat-badge {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 0.5rem 1.25rem;
        border-radius: 9999px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* Course Cards */
    .course-card {
        background: var(--learn-card-bg);
        border-radius: 1rem;
        border: 1px solid var(--learn-border);
        overflow: hidden;
        transition: all 0.25s ease;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    .course-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 24px -6px rgba(0, 0, 0, 0.1);
        border-color: #cbd5e1;
    }
    .course-card-header {
        background: linear-gradient(135deg, #4338ca 0%, #6366f1 100%);
        padding: 1.75rem 1.5rem;
        color: white;
        position: relative;
    }
    .course-card-title {
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
        line-height: 1.3;
    }
    .course-card-body {
        padding: 1.5rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .course-meta-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        color: var(--learn-text-muted);
        margin-bottom: 0.5rem;
    }
    .course-progress-bar {
        height: 8px;
        border-radius: 9999px;
        background-color: #e2e8f0;
        overflow: hidden;
        margin: 0.75rem 0 0.5rem 0;
    }
    .course-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #10b981 0%, #06b6d4 100%);
        border-radius: 9999px;
        transition: width 0.5s ease;
    }
    .continue-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(16,185,129,0.1);
        color: #059669;
        border: 1px solid rgba(16,185,129,0.25);
        border-radius: 9999px;
        padding: 0.2rem 0.75rem;
        font-size: 0.78rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    /* Toast */
    .toast-container-custom {
        position: fixed;
        top: 1.25rem;
        right: 1.25rem;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .toast-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.9rem 1.25rem;
        border-radius: 0.75rem;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        font-weight: 600;
        font-size: 0.95rem;
        min-width: 280px;
        max-width: 400px;
        animation: toastIn 0.3s ease;
    }
    .toast-success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
    .toast-error   { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    @@keyframes toastIn {
        from { opacity: 0; transform: translateX(30px); }
        to   { opacity: 1; transform: translateX(0); }
    }

    /* Unenroll confirm modal */
    .unenroll-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,0.55);
        backdrop-filter: blur(4px);
        z-index: 1055;
        align-items: center;
        justify-content: center;
    }
    .unenroll-overlay.active { display: flex; }
    .unenroll-card {
        background: #ffffff;
        border-radius: 1.25rem;
        box-shadow: 0 20px 60px rgba(0,0,0,0.18);
        padding: 2rem;
        max-width: 440px;
        width: 90%;
        animation: modalIn 0.25s ease;
    }
    @@keyframes modalIn {
        from { opacity: 0; transform: scale(0.93); }
        to   { opacity: 1; transform: scale(1); }
    }
    /* Pager */
    .pager {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 2rem;
        gap: 1rem;
    }
    .pager-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 1.25rem;
        border-radius: 9999px;
        font-weight: 600;
        font-size: 0.875rem;
        border: 1.5px solid rgba(255,255,255,0.25);
        background: rgba(255,255,255,0.1);
        color: #fff;
        text-decoration: none;
        transition: all 0.2s ease;
        backdrop-filter: blur(4px);
    }
    .pager-btn:hover:not(.disabled) {
        background: rgba(255,255,255,0.25);
        color: #fff;
        text-decoration: none;
    }
    .pager-btn.disabled {
        opacity: 0.35;
        pointer-events: none;
    }
    .pager-info {
        font-size: 0.875rem;
        color: rgba(255,255,255,0.75);
        font-weight: 500;
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="toast-container-custom" id="toastBox">
        <div class="toast-item toast-success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="toast-container-custom" id="toastBox">
        <div class="toast-item toast-error">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    </div>
}

<div class="learning-container">
    <div class="learn-hero">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h1 class="learn-hero-title"><i class="fas fa-graduation-cap me-2"></i> Không gian Học trực tuyến</h1>
                <p class="learn-hero-desc">Chào mừng bạn quay trở lại! Tiếp tục hoàn thành các bài học và thử sức với các bài thi trắc nghiệm để củng cố kiến thức vững vàng.</p>
                <div class="d-flex flex-wrap gap-2">
                    <span class="learn-stat-badge">
                        <i class="fas fa-book-open"></i> @Model.TotalCount Môn học đang tham gia
                    </span>
                    <span class="learn-stat-badge">
                        <i class="fas fa-check-circle text-success"></i> @Model.MyCourses.Sum(c => c.CompletedLessons) Bài học đã hoàn thành
                    </span>
                </div>
            </div>
            <div>
                <a href="/Subjects" class="btn btn-light btn-lg px-4 fw-bold shadow-sm">
                    <i class="fas fa-plus me-1"></i> Đăng ký thêm môn học
                </a>
            </div>
        </div>
    </div>

    @if (!Model.MyCourses.Any())
    {
        <div class="card p-5 text-center border-0 shadow-sm rounded-4 my-4">
            <div class="mb-3">
                <i class="fas fa-book-reader fa-4x text-muted opacity-50"></i>
            </div>
            <h3 class="fw-bold mb-2">Bạn chưa đăng ký môn học nào</h3>
            <p class="text-muted mx-auto mb-4" style="max-width: 500px;">
                Hãy khám phá danh mục các môn học trực tuyến phong phú, chọn môn học phù hợp và bắt đầu hành trình nâng cao năng lực ngay hôm nay.
            </p>
            <div>
                <a href="/Subjects" class="btn btn-primary btn-lg px-5 shadow-sm fw-bold">
                    <i class="fas fa-compass me-2"></i> Khám phá môn học ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h2 class="h4 fw-bold mb-0"><i class="fas fa-chalkboard-teacher text-primary me-2"></i> Môn học của bạn</h2>
            <span class="text-muted small">@Model.TotalCount môn học</span>
        </div>

        <div class="row g-4">
            @foreach (var course in Model.MyCourses)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="course-card">
                        <div class="course-card-header">
                            <h3 class="course-card-title text-truncate" title="@course.Name">@course.Name</h3>
                            <div class="small opacity-75">
                                @if (course.Teachers.Any())
                                {
                                    <span><i class="fas fa-user-tie me-1"></i> @string.Join(", ", course.Teachers.Select(t => t.Name ?? t.UserName))</span>
                                }
                                else
                                {
                                    <span><i class="fas fa-school me-1"></i> Khoa đào tạo</span>
                                }
                            </div>
                        </div>
                        <div class="course-card-body">
                            @if (course.CompletedLessons > 0)
                            {
                                <span class="continue-badge">
                                    <i class="fas fa-play-circle"></i> Đang học
                                </span>
                            }

                            <p class="text-muted small flex-grow-1" style="min-height: 40px;">
                                @(string.IsNullOrWhiteSpace(course.Description) ? "Khóa học trực tuyến với hệ thống chương mục và bài kiểm tra đánh giá toàn diện." : course.Description)
                            </p>

                            <div class="course-meta-item">
                                <i class="fas fa-layer-group text-primary"></i>
                                <span><strong>@course.TotalChapters</strong> chương · <strong>@course.TotalLessons</strong> bài học</span>
                            </div>
                            <div class="course-meta-item">
                                <i class="fas fa-file-pen text-info"></i>
                                <span><strong>@course.TotalExams</strong> bài kiểm tra / đề thi</span>
                            </div>

                            <div class="mt-2 mb-3">
                                <div class="d-flex justify-content-between align-items-center small fw-semibold">
                                    <span class="text-muted">Tiến độ hoàn thành:</span>
                                    <span class="text-success">@course.ProgressPercentage% (@course.CompletedLessons/@course.TotalLessons)</span>
                                </div>
                                <div class="course-progress-bar">
                                    <div class="course-progress-fill" style="width: @course.ProgressPercentage%;"></div>
                                </div>
                            </div>

                            <div class="d-grid mt-auto gap-2">
                                <a href="/Learning/Subject?subjectId=@course.Id" class="btn btn-primary fw-bold py-2 shadow-sm">
                                    <i class="fas fa-play-circle me-1"></i> @(course.CompletedLessons > 0 ? "Tiếp tục học" : "Vào học ngay")
                                </a>
                                @if (course.CompletedLessons == 0)
                                {
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm fw-semibold"
                                            onclick="confirmUnenroll(@course.Id, '@Html.Raw(course.Name.Replace("'", "\'"))')">
                                        <i class="fas fa-times me-1"></i> Hủy đăng ký
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="pager">
                <a href="/Learning?page=@(Model.CurrentPage - 1)" class="pager-btn @(Model.CurrentPage <= 1 ? "disabled" : "")">
                    <i class="fas fa-chevron-left"></i> Trước
                </a>
                <span class="pager-info">
                    Trang <strong>@Model.CurrentPage</strong> / <strong>@Model.TotalPages</strong>
                    &nbsp;·&nbsp; @Model.TotalCount môn học
                </span>
                <a href="/Learning?page=@(Model.CurrentPage + 1)" class="pager-btn @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    Tiếp <i class="fas fa-chevron-right"></i>
                </a>
            </div>
        }
    }
</div>

@* Confirm unenroll modal *@
<div id="unenrollOverlay" class="unenroll-overlay">
    <div class="unenroll-card">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div style="width:48px;height:48px;border-radius:50%;background:#fee2e2;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="fas fa-sign-out-alt text-danger" style="font-size:1.3rem;"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-0">Hủy đăng ký môn học?</h5>
                <p class="text-muted small mb-0">Hành động này không thể hoàn tác.</p>
            </div>
        </div>
        <p class="text-muted mb-4">Bạn sắp hủy đăng ký môn <strong id="unenrollSubjectName"></strong>. Bạn có thể đăng ký lại từ trang danh mục môn học.</p>
        <form method="post" id="unenrollForm" asp-page-handler="Unregister">
            @Html.AntiForgeryToken()
            <input type="hidden" id="unenrollSubjectId" name="subjectId" value="0" />
            <div class="d-flex gap-2 justify-content-end">
                <button type="button" class="btn btn-outline-secondary px-4"
                        onclick="closeUnenrollModal()">Hủy bỏ</button>
                <button type="submit" class="btn btn-danger px-4 fw-semibold">
                    <i class="fas fa-sign-out-alt me-1"></i> Xác nhận hủy
                </button>
            </div>
        </form>
    </div>
</div>

@section scripts {
<script>
    // ── Unenroll confirm modal ──────────────────────────
    function confirmUnenroll(subjectId, subjectName) {
        document.getElementById('unenrollSubjectId').value = subjectId;
        document.getElementById('unenrollSubjectName').textContent = subjectName;
        document.getElementById('unenrollOverlay').classList.add('active');
    }
    function closeUnenrollModal() {
        document.getElementById('unenrollOverlay').classList.remove('active');
    }

    // ── Toast auto-dismiss after 4s ──────────────────────
    var toast = document.getElementById('toastBox');
    if (toast) {
        setTimeout(function () {
            toast.style.transition = 'opacity 0.4s ease';
            toast.style.opacity = '0';
            setTimeout(function () { toast.remove(); }, 400);
        }, 4000);
    }
</script>
}
