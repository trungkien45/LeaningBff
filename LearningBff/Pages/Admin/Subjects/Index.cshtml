@page
@using LearningBff.Services.Dtos
@model LearningBff.Pages.Admin.Subjects.IndexModel
@{
    ViewData["Title"] = "Quản lý Môn học";

}

<div class="admin-subjects-page">
    <div class="page-header">
        <div class="page-title">
            <i class="fas fa-book"></i>
            <h1>Quản lý Môn học</h1>
        </div>
        <button class="btn-primary" onclick="openCreateModal()">
            <i class="fas fa-plus"></i> Thêm môn học
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> @Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage</div>
    }

    <div class="subjects-grid">
        @foreach (var subject in Model.Subjects)
        {
            <div class="subject-card @(subject.IsActive ? "" : "inactive")">
                <div class="subject-card-header">
                    <div class="subject-icon"><i class="fas fa-book-open"></i></div>
                    <div class="subject-status @(subject.IsActive ? "active" : "inactive")">
                        @(subject.IsActive ? "Hoạt động" : "Ẩn")
                    </div>
                </div>
                <h3 class="subject-name">@subject.Name</h3>
                @if (!string.IsNullOrEmpty(subject.Description))
                {
                    <p class="subject-desc">@subject.Description</p>
                }
                <div class="subject-stats">
                    <span><i class="fas fa-question-circle"></i> @subject.QuestionCount câu hỏi</span>
                    <span><i class="fas fa-file-alt"></i> @subject.ExamCount đề thi</span>
                </div>
                <div class="subject-actions">
                    <a href="/Admin/Questions?subjectId=@subject.Id" class="btn-sm btn-info">
                        <i class="fas fa-list"></i> Câu hỏi
                    </a>
                    <button class="btn-sm btn-warning" onclick="openEditModal(@subject.Id)">
                        <i class="fas fa-edit"></i> Sửa
                    </button>
                    <form method="post" asp-page-handler="Delete" style="display:inline"
                          onsubmit="return confirm('Xóa môn học @subject.Name?')">
                        <input type="hidden" name="id" value="@subject.Id" />
                        <button type="submit" class="btn-sm btn-danger">
                            <i class="fas fa-trash"></i> Xóa
                        </button>
                    </form>
                </div>
            </div>
        }
        @if (!Model.Subjects.Any())
        {
            <div class="empty-state">
                <i class="fas fa-book"></i>
                <p>Chưa có môn học nào. Hãy tạo môn học đầu tiên!</p>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Phân trang môn học">
            <ul class="pagination align-items-center mb-0">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item"><a class="page-link" asp-page="./Index" asp-route-page="@(Model.CurrentPage - 1)">Trước</a></li>
                }
                <li class="page-item disabled"><span class="page-link">Trang @Model.CurrentPage / @Model.TotalPages · @Model.TotalCount môn học</span></li>
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item"><a class="page-link" asp-page="./Index" asp-route-page="@(Model.CurrentPage + 1)">Sau</a></li>
                }
            </ul>
        </nav>
    }
</div>

<!-- Create Modal -->
<div id="createModal" class="modal-overlay" style="display:none">
    <div class="modal">
        <div class="modal-header">
            <h2><i class="fas fa-plus-circle"></i> Thêm môn học</h2>
            <button onclick="closeModal('createModal')" class="modal-close">&times;</button>
        </div>
        <form method="post" asp-page-handler="Create">
            <div class="modal-body">
                <div class="form-group">
                    <label>Tên môn học <span class="required">*</span></label>
                    <input type="text" name="Name" id="createName" required maxlength="256" placeholder="Ví dụ: Toán, Lý, Hóa..." />
                </div>
                <div class="form-group">
                    <label>Mô tả</label>
                    <textarea name="Description" id="createDesc" rows="3" maxlength="1024" placeholder="Mô tả ngắn về môn học..."></textarea>
                </div>
                <div class="form-group form-check">
                    <input type="checkbox" name="IsActive" id="createIsActive" value="true" checked />
                    <label for="createIsActive">Kích hoạt</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeModal('createModal')" class="btn-secondary">Hủy</button>
                <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Lưu</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="modal-overlay" style="display:none">
    <div class="modal">
        <div class="modal-header">
            <h2><i class="fas fa-edit"></i> Sửa môn học</h2>
            <button onclick="closeModal('editModal')" class="modal-close">&times;</button>
        </div>
        <form method="post" asp-page-handler="Update">
            <div class="modal-body">
                <input type="hidden" name="Id" id="editId" />
                <div class="form-group">
                    <label>Tên môn học <span class="required">*</span></label>
                    <input type="text" name="Name" id="editName" required maxlength="256" />
                </div>
                <div class="form-group">
                    <label>Mô tả</label>
                    <textarea name="Description" id="editDesc" rows="3" maxlength="1024"></textarea>
                </div>
                <div class="form-group form-check">
                    <input type="checkbox" name="IsActive" id="editIsActive" value="true" />
                    <label for="editIsActive">Kích hoạt</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeModal('editModal')" class="btn-secondary">Hủy</button>
                <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Cập nhật</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
const subjectsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Subjects));

function openCreateModal() {
    document.getElementById('createModal').style.display = 'flex';
}
function openEditModal(id) {
    const s = subjectsData.find(x => (x.Id === id || x.id === id));
    if (!s) return;
    document.getElementById('editId').value = s.Id ?? s.id ?? 0;
    document.getElementById('editName').value = s.Name ?? s.name ?? '';
    document.getElementById('editDesc').value = s.Description ?? s.description ?? '';
    document.getElementById('editIsActive').checked = !!(s.IsActive ?? s.isActive);
    document.getElementById('editModal').style.display = 'flex';
}
function closeModal(id) {
    document.getElementById(id).style.display = 'none';
}
document.querySelectorAll('.modal-overlay').forEach(o => {
    o.addEventListener('click', e => { if (e.target === o) o.style.display = 'none'; });
});
</script>
}
