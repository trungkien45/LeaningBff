@page
@using LearningBff.Entities
@model LearningBff.Pages.Admin.Exams.QuestionsModel
@{
    ViewData["Title"] = $"Câu hỏi — {Model.Exam?.Title}";
}

<div class="exam-questions-page">
    <div class="page-header">
        <div class="page-title">
            <a href="/Admin/Exams" class="back-link"><i class="fas fa-arrow-left"></i></a>
            <i class="fas fa-list-ol"></i>
            <div>
                <h1>@Model.Exam?.Title</h1>
                <small>@Model.Exam?.SubjectName · @Model.Exam?.DurationInMinutes phút · @Model.Exam?.QuestionCount câu hỏi</small>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    { <div class="alert alert-success"><i class="fas fa-check-circle"></i> @Model.SuccessMessage</div> }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    { <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage</div> }

    <div class="eq-layout">
        <!-- Câu hỏi trong đề thi -->
        <div class="eq-panel">
            <div class="panel-header">
                <h2><i class="fas fa-check-square"></i> Câu hỏi trong đề (@Model.ExamQuestions.Count)</h2>
            </div>
            <div class="eq-list">
                @if (!Model.ExamQuestions.Any())
                {
                    <div class="empty-state"><i class="fas fa-inbox"></i><p>Chưa có câu hỏi nào trong đề.</p></div>
                }
                @{int idx = 1;}
                @foreach (var eq in Model.ExamQuestions)
                {
                    <div class="eq-item">
                        <div class="eq-num">@(idx++)</div>
                        <div class="eq-content">
                            <div class="eq-title">@eq.QuestionTitle</div>
                            <div class="eq-meta">
                                <span class="badge badge-type @(eq.QuestionType == QuestionType.Single ? "single" : "multi")">
                                    @(eq.QuestionType == QuestionType.Single ? "Một đáp án" : "Nhiều đáp án")
                                </span>
                                <span><i class="fas fa-star"></i> @eq.Score điểm</span>
                            </div>
                        </div>
                        <form method="post" asp-page-handler="RemoveQuestion">
                            <input type="hidden" name="examId"    value="@Model.ExamId" />
                            <input type="hidden" name="questionId" value="@eq.QuestionId" />
                            <button type="submit" class="btn-icon btn-danger" title="Xóa khỏi đề">
                                <i class="fas fa-minus-circle"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- Ngân hàng câu hỏi -->
        <div class="eq-panel">
            <div class="panel-header">
                <h2><i class="fas fa-database"></i> Ngân hàng câu hỏi</h2>
                <form method="get">
                    <input type="hidden" name="examId" value="@Model.ExamId" />
                    <input type="hidden" name="page" value="1" />
                    <select name="subjectId" class="filter-select" onchange="this.form.submit()">
                        <option value="" selected="@(Model.BankSubjectId == null)">-- Tất cả môn học --</option>
                        @foreach (var s in Model.Subjects)
                        {
                            <option value="@s.Id" selected="@(Model.BankSubjectId == s.Id)">@s.Name</option>
                        }
                    </select>
                </form>
            </div>
            <div class="eq-list" id="bankList">
                @foreach (var q in Model.AvailableQuestions)
                {
                    var alreadyAdded = Model.ExamQuestions.Any(eq => eq.QuestionId == q.Id);
                    <div class="eq-item bank-item" data-subject="@q.SubjectId">
                        <div class="eq-content">
                            <div class="eq-title">@q.Title</div>
                            <div class="eq-meta">
                                <span class="badge badge-subject">@q.SubjectName</span>
                                <span class="badge badge-type @(q.Type == QuestionType.Single ? "single" : "multi")">
                                    @(q.Type == QuestionType.Single ? "Một đáp án" : "Nhiều đáp án")
                                </span>
                                <span><i class="fas fa-star"></i> @q.DefaultScore điểm</span>
                            </div>
                        </div>
                        @if (!alreadyAdded)
                        {
                            <form method="post" asp-page-handler="AddQuestion">
                                <input type="hidden" name="examId"    value="@Model.ExamId" />
                                <input type="hidden" name="questionId" value="@q.Id" />
                                <input type="hidden" name="score"      value="@q.DefaultScore" />
                                <button type="submit" class="btn-icon btn-success" title="Thêm vào đề">
                                    <i class="fas fa-plus-circle"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="badge badge-added"><i class="fas fa-check"></i> Đã thêm</span>
                        }
                    </div>
                }
                @if (!Model.AvailableQuestions.Any())
                {
                    <div class="empty-state"><i class="fas fa-inbox"></i><p>Môn học này chưa có câu hỏi.</p></div>
                }
            </div>
            @if (Model.TotalPages > 1)
            {
                <nav class="mt-3" aria-label="Phân trang ngân hàng câu hỏi">
                    <ul class="pagination align-items-center mb-0">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Questions" asp-route-examId="@Model.ExamId" asp-route-subjectId="@Model.BankSubjectId" asp-route-page="@(Model.CurrentPage - 1)">Trước</a>
                            </li>
                        }
                        <li class="page-item disabled"><span class="page-link">Trang @Model.CurrentPage / @Model.TotalPages · @Model.TotalCount câu hỏi</span></li>
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Questions" asp-route-examId="@Model.ExamId" asp-route-subjectId="@Model.BankSubjectId" asp-route-page="@(Model.CurrentPage + 1)">Sau</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
</script>
}
