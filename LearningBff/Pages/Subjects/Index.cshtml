@page
@model LearningBff.Pages.Subjects.IndexModel
@{
    ViewData["Title"] = "Đăng ký môn học";
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Đăng ký môn học</h1>
            <p class="text-muted mb-0">Chọn các môn bạn muốn theo học.</p>
        </div>
        <span class="badge bg-primary">Đã đăng ký: @Model.Subjects.Count(x => x.IsRegistered)</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    @if (!Model.Subjects.Any())
    {
        <div class="alert alert-info">Hiện chưa có môn học nào được mở đăng ký.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Môn học</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var subject in Model.Subjects)
                    {
                        <tr>
                            <td class="fw-semibold">@subject.Name</td>
                            <td>@(string.IsNullOrWhiteSpace(subject.Description) ? "Chưa có mô tả" : subject.Description)</td>
                            <td>
                                @if (subject.IsRegistered)
                                {
                                    <span class="badge bg-success">Đã đăng ký</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Chưa đăng ký</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (subject.IsRegistered)
                                {
                                    <form method="post" asp-page-handler="Unregister" class="d-inline">
                                        <input type="hidden" name="subjectId" value="@subject.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Hủy đăng ký</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Register" class="d-inline">
                                        <input type="hidden" name="subjectId" value="@subject.Id" />
                                        <button type="submit" class="btn btn-primary btn-sm">Đăng ký</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>