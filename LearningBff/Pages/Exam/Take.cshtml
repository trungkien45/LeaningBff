@page "{id:long}"
@using LearningBff.Entities
@model LearningBff.Pages.Exam.TakeModel
@{
    ViewData["Title"] = $"Làm bài — {Model.Exam?.Title}";

}

<div class="take-exam-page" id="takeExamPage">
    <!-- Sticky header with timer -->
    <div class="exam-sticky-header">
        <div class="exam-header-info">
            <span class="exam-header-title"><i class="fas fa-file-alt"></i> @Model.Exam?.Title</span>
            <span class="exam-header-subject">@Model.Exam?.SubjectName</span>
        </div>
        <div class="exam-timer" id="examTimer">
            <i class="fas fa-clock"></i>
            <span id="timerDisplay">@((Model.RemainingSeconds / 60).ToString("D2")):@((Model.RemainingSeconds % 60).ToString("D2"))</span>
        </div>
        <div class="exam-progress">
            <span id="answeredCount">0</span>/@Model.Exam?.QuestionCount câu
        </div>
    </div>

    <form method="post" asp-page-handler="Submit" id="examForm">
        <input type="hidden" name="ExamResultId" value="@Model.ResultId" />

        <div class="questions-container">
            @{int qIdx = 0;}
            @foreach (var eq in Model.Questions)
            {
                qIdx++;
                <div class="question-block" id="q-@eq.QuestionId" data-answered="false">
                    <div class="question-header">
                        <div class="question-number">Câu @qIdx</div>
                        <div class="question-type-badge @(eq.QuestionType == QuestionType.Single ? "single" : "multi")">
                            @(eq.QuestionType == QuestionType.Single ? "Chọn một" : "Chọn nhiều")
                        </div>
                        <div class="question-score"><i class="fas fa-star"></i> @eq.Score điểm</div>
                    </div>

                    <p class="question-text">@eq.QuestionTitle</p>

                    <div class="answers-options">
                        @{int aIdx = 0;}
                        @foreach (var a in eq.Answers)
                        {
                            var inputType = eq.QuestionType == QuestionType.Single ? "radio" : "checkbox";
                            var inputName = $"Answers[{qIdx - 1}].SelectedAnswerIds";
                            <label class="answer-option" for="a-@eq.QuestionId-@aIdx">
                                <input type="@inputType"
                                       id="a-@eq.QuestionId-@aIdx"
                                       name="Answers[@(qIdx-1)].SelectedAnswerIds"
                                       value="@a.Id"
                                       data-qblock="q-@eq.QuestionId"
                                       onchange="onAnswerChange(this)" />
                                <span class="answer-option-marker">@("ABCD"[aIdx])</span>
                                <span class="answer-option-text">@a.Text</span>
                            </label>
                            aIdx++;
                        }
                    </div>

                    <input type="hidden" name="Answers[@(qIdx-1)].QuestionId" value="@eq.QuestionId" />
                </div>
            }
        </div>

        <!-- Submit bar -->
        <div class="submit-bar">
            <div class="submit-progress">
                <div class="progress-bar">
                    <div class="progress-fill" id="progressFill" style="width:0%"></div>
                </div>
                <span id="progressText">0 / @Model.Questions.Count câu đã trả lời</span>
            </div>
            <button type="button" class="btn-submit-exam" onclick="confirmSubmit()">
                <i class="fas fa-paper-plane"></i> Nộp bài
            </button>
        </div>
    </form>

    <!-- Confirm dialog -->
    <div id="submitConfirm" class="modal-overlay" style="display:none">
        <div class="modal modal-confirm">
            <div class="modal-body text-center">
                <i class="fas fa-paper-plane confirm-icon"></i>
                <h3>Xác nhận nộp bài?</h3>
                <p id="confirmText">Bạn đã trả lời <strong id="confirmedCount">0</strong>/@Model.Questions.Count câu.</p>
                <p class="confirm-warning">Sau khi nộp bài, bạn sẽ không thể sửa đáp án.</p>
            </div>
            <div class="modal-footer">
                <button onclick="document.getElementById('submitConfirm').style.display='none'" class="btn-secondary">
                    Làm tiếp
                </button>
                <button onclick="document.getElementById('examForm').submit()" class="btn-primary">
                    <i class="fas fa-check"></i> Nộp bài
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let remainingSeconds = @Model.RemainingSeconds;
let totalQuestions = @Model.Questions.Count;

// Timer
function updateTimer() {
    if (remainingSeconds <= 0) {
        document.getElementById('timerDisplay').textContent = "00:00";
        document.getElementById('examForm').submit();
        return;
    }
    const m = String(Math.floor(remainingSeconds / 60)).padStart(2, '0');
    const s = String(remainingSeconds % 60).padStart(2, '0');
    document.getElementById('timerDisplay').textContent = `${m}:${s}`;

    const timerEl = document.getElementById('examTimer');
    if (remainingSeconds <= 300) timerEl.classList.add('warning');
    if (remainingSeconds <= 60)  timerEl.classList.add('danger');

    remainingSeconds--;
    setTimeout(updateTimer, 1000);
}
updateTimer();

// Answer change
function onAnswerChange(input) {
    const blockId  = input.dataset.qblock;
    const block    = document.getElementById(blockId);
    const answered = block.querySelectorAll('input:checked').length > 0;
    block.dataset.answered = answered;
    block.classList.toggle('answered', answered);
    updateProgress();
}

function updateProgress() {
    const answered = document.querySelectorAll('.question-block[data-answered="true"]').length;
    document.getElementById('answeredCount').textContent  = answered;
    document.getElementById('progressText').textContent   = `${answered} / ${totalQuestions} câu đã trả lời`;
    document.getElementById('progressFill').style.width   = `${(answered / totalQuestions) * 100}%`;
}

function confirmSubmit() {
    const answered = document.querySelectorAll('.question-block[data-answered="true"]').length;
    document.getElementById('confirmedCount').textContent = answered;
    document.getElementById('submitConfirm').style.display = 'flex';
}
</script>
}
